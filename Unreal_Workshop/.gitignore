# =============================================================================
# Unreal_Workshop — this workspace holds NO media.
#
# It contains instructions (AGENTS.md), skills (.skills/), a memory bank
# (.vault/) and the tools (tools/). Everything Unreal produces lives in the
# DESTINATION the user confirmed — an Unreal project under D:\UE\<Project>\ —
# never in this tree.
#
# See .vault/decisions/2026-11-15-workspace-holds-no-media.md
# =============================================================================

# --- scratch: scripts and logs, reproducible from the recipes -----------------
work/*
!work/.gitkeep
*.log
*.tmp
*.bak
*.orig
*.rej

# --- Unreal packages: binary, absolute-path-bound, and the user's work --------
# A .uasset/.umap is the deliverable of this app and belongs in a project's
# Content/ folder, not here.
*.uasset
*.umap
*.uexp
*.ubulk
*.uptnl
*.uplugin
*.utoc
*.ucas
*.sig
*.container
*.pak

# --- a whole Unreal project tree ---------------------------------------------
# If someone copies a project into this folder, none of it belongs here.
*.uproject
*.uplugin
Config/*.ini
Config/**/*.ini
Content/
Source/
Plugins/
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/
Cooked/

# --- renders, images and image sequences --------------------------------------
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff
*.tif
*.ico
*.svg
*.psd
*.exr
*.hdr
*.tga
*.dpx
*.bmp16
*.pf
*.pfsoft
*.pc

# --- textures and image maps used by the scene --------------------------------
# (kept separate so a texture sweep cannot smuggle media in under an
#  asset-adjacent name)
textures/
*.tex
*.vtex
*.dds
*.ktx
*.ktx2
*.astc

# --- imported models ----------------------------------------------------------
*.fbx
*.obj
*.gltf
*.glb
*.abc
*.usd
*.usda
*.usdc
*.usdz
*.stl
*.ply
*.dae
*.3ds
*.mtl

# --- audio --------------------------------------------------------------------
*.wav
*.ogg
*.mp3
*.aif
*.aiff
*.flac
*.opus
*.wma
*.m4a

# --- video and capture --------------------------------------------------------
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.m4v
*.mxf
*.braw
*.r3d

# --- compiled binaries and build output ---------------------------------------
*.dll
*.exe
*.pdb
*.modules
*.target
*.core
*.crash
*.stack
*.patch_*.exe

# --- caches -------------------------------------------------------------------
*.cache
cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- archives -----------------------------------------------------------------
*.zip
*.7z
*.tar.gz

# --- language / editor caches -------------------------------------------------
node_modules/
.vscode/
.idea/

# --- secrets: this workspace needs none, so refuse them all -------------------
.env
.env.*
!.env.example

# --- OS / editor noise --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
desktop.ini.*
$RECYCLE.BIN/
