# =============================================================================
# ComfyUI_Workshop — this workspace holds NO media.
#
# It contains instructions (AGENTS.md), skills (.skills/), a memory bank
# (.vault/) and the tools (tools/). Generated images, video, audio, meshes and
# model files live in the DESTINATION the user confirmed, outside this tree.
#
# See .vault/decisions/2026-11-13-workspace-holds-no-media.md
# =============================================================================

# --- scratch: build artifacts and logs, reproducible from the recipes ---------
work/
*.log
*.tmp
*.bak
*.orig
*.rej

# --- runtime state produced by the boot tooling ------------------------------
*.pid
tools/.comfyui.pid

# --- MEDIA: never belongs in this tree ---------------------------------------
# images
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff
*.tif
*.ico
*.svg
*.psd
*.exr
*.hdr
# video
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.m4v
*.wmv
# audio
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
# 3D
*.glb
*.gltf
*.obj
*.fbx
*.blend
*.dae
*.stl
*.ply
# model weights
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.engine
# archives that are usually big binaries
*.zip
*.7z
*.tar.gz

# --- language / tool caches ---------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.vscode/
.idea/

# --- secrets: this workspace needs none, so refuse them all -------------------
.env
.env.*
!.env.example

# --- OS / editor noise --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
desktop.ini.*
$RECYCLE.BIN/
